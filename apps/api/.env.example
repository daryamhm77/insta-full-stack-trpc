PORT=3001
WEB_URL=http://localhost:3000

# Postgres (used by Drizzle + Better Auth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insta
# Set to true for hosted Postgres that requires TLS (Neon, RDS, etc.)
DATABASE_SSL=false

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-char-minimum-secret
BETTER_AUTH_URL=http://localhost:3001

# Upload storage: local | s3 (s3 not wired yet)
STORAGE_TYPE=local
