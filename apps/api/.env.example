PORT=3001
WEB_URL=http://localhost:3000

# Postgres (used by Drizzle + Better Auth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insta
# Set to true for hosted Postgres (Render, Neon, RDS)
DATABASE_SSL=false
# Set to false if the host uses a certificate Node does not trust (common on Render)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-char-minimum-secret
# Local: API origin. Production: the Vercel site URL (browser origin for /api/auth)
BETTER_AUTH_URL=http://localhost:3001

# Upload storage: local | cloudinary | s3
# Use cloudinary if you have no credit card (see DEPLOY.md).
STORAGE_TYPE=local

# Required when STORAGE_TYPE=cloudinary (no credit card)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Required when STORAGE_TYPE=s3 (AWS S3 or Cloudflare R2 — both need a card)
# S3_BUCKET=insta-photos
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public URL used in <img src>. For AWS this can be omitted.
# For R2 / MinIO this is required (e.g. https://pub-xxxx.r2.dev)
# S3_PUBLIC_URL=
# Only for S3-compatible hosts (R2, MinIO), not AWS
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
