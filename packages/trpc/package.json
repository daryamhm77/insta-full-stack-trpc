{
  "name": "@repo/trpc",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./router": {
      "types": "./dist/server/server.d.ts",
      "require": "./dist/server/server.js",
      "import": "./dist/server/server.js",
      "default": "./src/server/server.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "require": "./dist/schemas/index.js",
      "import": "./dist/schemas/index.js",
      "default": "./src/schemas/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@trpc/server": "^11.18.0",
    "typescript": "5.9.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@trpc/server": "^11.5.0",
    "zod": "^4.0.0"
  }
}
